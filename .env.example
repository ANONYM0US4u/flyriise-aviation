# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Content mode.
#   demo       — client preview: the full site, including reference content
#                (career destinations, statistics) awaiting sign-off.
#   production — hard-gates unverified partners / statistics / testimonials so
#                they are not reachable from a production route.
CONTENT_MODE=demo

# File name used by the mock lead sink, written inside ./.data (gitignored).
# Not usable on serverless hosts (read-only filesystem) — set LEAD_SINK_URL there.
LEAD_SINK_FILE=leads.jsonl

# Where enquiries are delivered. Any endpoint that accepts a JSON POST works:
# a CRM webhook, or the Apps Script web app in docs/apps-script/lead-webhook.gs
# that writes each enquiry to a sheet and emails it to admissions.
# Server-side only — never referenced from client code.
# LEAD_SINK_URL=

# Public origin, used for canonical URLs, sitemap and Open Graph tags.
# Must be set BEFORE the build, or the wrong origin is baked in.
# NEXT_PUBLIC_SITE_URL=https://www.flyriiseaviation.in

# Optional: WhatsApp business number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=917595952320
